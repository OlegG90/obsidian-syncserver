{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023"
    ],
    "outDir": "types",
    "rootDir": "src",
    "composite": true,
    // JavaScript as well as declarations: the request-body schemas run, in the server (D-143).
    "tsBuildInfoFile": "types/.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts"
  ]
}
