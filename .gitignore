# Build output and dependencies
node_modules/
dist/
build/
*.tsbuildinfo

# `shared/` emits declarations rather than a build, into `types/` rather than `dist/`, so the
# rule above does not reach it. Generated all the same: tsc writes it from `shared/src`, and a
# rebuild restores it.
shared/types/

# Local environment and secrets. `.env` is the whole of a deployment's configuration and
# holds both of its secrets, so the example is the only one that may ever be committed.
.env
.env.*
!.env.example

# Logs and database dumps. A dump is plaintext metadata for a whole installation.
*.log
pg_dump_*.sql

# The development blob store: real encrypted content, at real addresses.
var/

# Deployment: bind-mounted data and the stamps pack.sh writes into them. The archives land
# in dist/deploy, which the dist/ rule above already covers — every build output in this
# repository is called dist.
data/
VERSION
MANIFEST.sha256

# Host profiles: the scripts and settings for named machines. A hostname, an address, a
# share layout and an account are nobody else's business, and the generic half of every one
# of them is already in tools/ — see docs/13, "Host profiles".
deploy/

# Editors and operating systems. Nothing here is anyone else's business.
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
