{
  "name": "@syncserver/server",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "description": "Sync API and background worker: delta, node writes, blobs, shares, quota",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b ../shared && tsc --noEmit -p tsconfig.test.json",
    "dev": "tsx watch --conditions=source src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --conditions=source --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.7",
    "@noble/hashes": "^2.4.0",
    "@fastify/websocket": "^11.3.7",
    "@syncserver/shared": "*",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15"
  }
}
