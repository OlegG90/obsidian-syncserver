{
  "name": "@syncserver/server",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "description": "Sync API and background worker: delta, node writes, blobs, shares, quota",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b ../shared && tsc --noEmit -p tsconfig.test.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.1",
    "@noble/hashes": "^2.3.0",
    "@fastify/websocket": "^11.3.0",
    "@syncserver/shared": "*",
    "fastify": "^5.11.2",
    "pg": "^8.22.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/pg": "^8.20.4",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.9"
  }
}
